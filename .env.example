# Скопируйте в .env (cp .env.example .env). Файл .env в git не попадает (.gitignore).
# Всё здесь НЕОБЯЗАТЕЛЬНО: без OPENAI_API_KEY агент работает детерминированно (правила + шаблон отчёта).

# Ключ OpenAI API — включает LLM-режим агента (tool calling, анализ и отчёт).
OPENAI_API_KEY=

# Модель OpenAI для агента.
OPENAI_MODEL=gpt-5-mini

# Совместимый с OpenAI endpoint (прокси, локальный сервер). По умолчанию — api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Уровень рассуждений для reasoning-моделей (gpt-5*, o*): minimal | low | medium | high. По умолчанию low.
# OPENAI_REASONING_EFFORT=low
