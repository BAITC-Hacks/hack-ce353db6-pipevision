# syntax=docker/dockerfile:1
# Панель оператора WindAgent (Streamlit) для деплоя на сервер (Railway / любой Docker-хостинг).
# Данные организаторов, кэш Open-Meteo и обученная модель лежат в образе, поэтому ретроспектива
# по ВЭС «Нурлы» работает без сети; live-режим и другие площадки ходят в Open-Meteo, LLM — при OPENAI_API_KEY.
#   docker build -f deploy/Dockerfile.ui -t wind-agent-ui .
#   docker run --rm -p 8501:8501 -e PORT=8501 wind-agent-ui
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8501

WORKDIR /app

COPY pyproject.toml README.md requirements.lock ./
COPY src ./src
RUN pip install -e ".[ui]" -c requirements.lock

COPY . .

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s CMD python -c "import urllib.request,os; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",\"8501\")}/_stcore/health')" || exit 1
CMD ["sh", "-c", "streamlit run ui/app.py --server.port ${PORT} --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
